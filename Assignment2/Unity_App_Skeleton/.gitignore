# This .gitignore file is optimized for Unity MRTK3 projects
# It excludes sensitive files, temporary files, and local machine-specific files from version control

# ===== UNITY CORE =====
# Unity-generated files and folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Asset meta-data not meant for version control
/[Aa]ssets/AssetStoreTools*

# ===== VISUAL STUDIO & IDEs =====
# Visual Studio
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ===== UNITY CRASH REPORTS =====
sysinfo.txt
crash.dmp
error.log
crash.png

# ===== BUILD OUTPUTS =====
*.apk
*.aab
*.app
*.exe
*.ipa
*.unitypackage
*.appx
*.msix
*.xap

# ===== MRTK & MIXED REALITY =====
# MRTK Generated files
Assets/MRTK.Generated/
# Mixed Reality specific builds
*.appxbundle
*.msixbundle
# Holographic remoting
*.holographic

# ===== PACKAGE MANAGEMENT =====
# NuGet
packages/
*.nupkg
# Unity Package Manager
Packages/packages-lock.json.backup

# ===== OPERATING SYSTEMS =====
# Windows
Thumbs.db
Thumbs.db.meta
Desktop.ini
# macOS
.DS_Store
.DS_Store.meta
# Linux
*~

# ===== BACKUPS & TEMP FILES =====
*.bak
*.backup
*.orig
*.rej
*~

# ===== LOCAL CONFIGURATION =====
# Local Unity settings that might differ per machine
ProjectSettings/ProjectVersion.txt
ProjectSettings/EditorBuildSettings.asset
ProjectSettings/EditorSettings.asset

# ===== DEVELOPMENT TOOLS =====
# Test results
TestResults/
# Benchmark results
BenchmarkResults/
# Code coverage
CodeCoverage/

# ===== CUSTOM ASSETS =====
# Uncomment and modify as needed for your project
# Assets/MyCustomAssets/
# Assets/StreamingAssets/

# ===== NOTES =====
# If you need to commit any of the above, use git add -f <filename>
# For example: git add -f Assets/StreamingAssets/myfile.txt
